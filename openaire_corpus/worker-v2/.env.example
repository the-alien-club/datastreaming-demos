# OpenAIRE ingest worker (worker-v2) — environment template.
# Copy to worker-v2/.env and fill in. Boot-time vars (config.ts) THROW at startup
# if missing; the live-client vars (RunPod / data-cluster) are read lazily on the
# first embed / register call, so an abstract-only dev run fails fast only when it
# actually needs them.

# --- Boot-time (required by config.ts) --------------------------------------
# Reuse the app's Postgres — the worker owns its own `sandbox_ingest_v2` schema
# (pg-boss + doc-state) and auto-migrates it on start; it never touches Prisma tables.
DATABASE_URL="postgresql://…@localhost:5434/openaire_corpus"
# app↔worker HTTP ingress (POST /ingest, GET /progress/:runId). Must match the
# app's WORKER_RUNNER_URL.
WORKER_HTTP_PORT=7777

# S3 blob store — heavy bytes live off-queue. OpenAIRE artifacts sit under a
# dedicated prefix so they never collide with other tenants in a shared bucket.
SCW_S3_BUCKET="…"
SCW_S3_ACCESS_KEY="…"
SCW_S3_SECRET_KEY="…"
SCW_S3_ENDPOINT_URL="https://s3.fr-par.scw.cloud"
SCW_S3_REGION="fr-par"
V2_S3_PREFIX="openaire/"

# --- OpenAIRE Graph API + ScholeXplorer (public; token optional) ------------
# OPENAIRE_API_BASE="https://api.openaire.eu/graph/v1"   # default
# OPENAIRE_API_TOKEN="…"                                 # raises the rate ceiling
OPENAIRE_RPM=60
# ScholeXplorer citation-link enrichment (cited-by / references counts).
SCHOLEX_ENABLED=true
SCHOLEX_RPM=60

# --- Full-text lane ---------------------------------------------------------
# false = abstract + metadata only (B-M1). true = also fetch open-access PDFs and
# OCR them via Mistral (B-M2) → per-page full text + inline figure captions.
FULLTEXT_ENABLED=true
# Required when FULLTEXT_ENABLED=true (read lazily by the OCR extractor).
MISTRAL_API_KEY="…"
MISTRAL_OCR_MODEL="mistral-ocr-latest"
# PDF_HOST_RPM=60
# PDF_MAX_BYTES=52428800
# PDF_MAX_PAGES=500

# --- RunPod bge-m3 embedder (lazy — first embed) ----------------------------
RUNPOD_API_KEY="…"
RUNPOD_EMBEDDING_ENDPOINT_ID="…"
RUNPOD_EMBEDDING_MODEL="BAAI/bge-m3"

# --- Data-cluster sink (lazy — first register) ------------------------------
# The worker indexes through BACKEND_API_URL/clusters/CLUSTER_ID/proxy.
BACKEND_API_URL="https://api.alpha.alien.club"
CLUSTER_ID="…"
CLUSTER_BEARER_TOKEN="…"
