# OpenAIRE Literature Research — environment template.
# Copy to .env.local and fill in. Boot-time vars (top block) are required for the
# server to start; the rest are lazy / feature-toggled.

# --- Boot-time (required) ---------------------------------------------------
# Local dev points at the datastreaming-postgres-platform container (:5434),
# database `openaire_corpus`.
DATABASE_URL="postgresql://platform_user:platform_dev_password@localhost:5434/openaire_corpus"
BETTER_AUTH_SECRET="change-me-to-a-32-plus-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
ANTHROPIC_API_KEY="sk-ant-…"
APP_URL="http://localhost:3000"

# --- OpenAIRE MCP (lazy — required on first agent search) -------------------
# The hosted mcp-openaire endpoint (openaire_* tools: search / get details /
# search projects / research links / citation network).
OPENAIRE_MCP_URL="https://…/mcp"
OPENAIRE_MCP_TOKEN="…"

# --- Ingestion cluster ------------------------------------------------------
# fake = app + Postgres only (no worker); real = talk to the ingest worker.
CLUSTER_MODE="fake"
# real mode only — base URL of the worker's HTTP ingress (POST /ingest).
# WORKER_RUNNER_URL="http://localhost:7777"
# The worker HMAC-signs its terminal callback back to the app. In docker-compose
# the worker cannot resolve the app's localhost; point it back at the host.
# When the worker runs on the host (local `npm start`), use the app's own URL.
# WORKER_CALLBACK_BASE_URL="http://localhost:3000"

# --- Data-cluster MCP (lazy — required when CLUSTER_MODE=real for RAG) -------
DATACLUSTER_MCP_URL="https://…/mcp"
CLUSTER_BEARER_TOKEN="…"

# --- Agent provider (optional; default anthropic) ---------------------------
AGENT_PROVIDER="anthropic"
# OPENROUTER_API_KEY="sk-or-…"   # required when AGENT_PROVIDER=openrouter

# --- Alien Auth (Authentik OIDC) SSO — optional -----------------------------
# AUTHENTIK_BASE_URL="https://auth.example.com"
# AUTHENTIK_APP_SLUG="datastreaming"
# AUTHENTIK_CLIENT_ID="…"
# AUTHENTIK_CLIENT_SECRET="…"

# --- Langfuse observability — optional --------------------------------------
# LANGFUSE_PUBLIC_KEY="pk-lf-…"
# LANGFUSE_SECRET_KEY="sk-lf-…"
# LANGFUSE_BASE_URL="https://cloud.langfuse.com"
