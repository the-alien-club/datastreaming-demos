# OpenAIRE Literature Research — environment template.
# Copy to .env.local and fill in. Boot-time vars (top block) are required for the
# server to start; the rest are lazy / feature-toggled.

# --- Boot-time (required) ---------------------------------------------------
DATABASE_URL="postgresql://platform_user:platform_dev_password@localhost:5432/openaire_corpus"
BETTER_AUTH_SECRET="change-me-to-a-32-plus-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
ANTHROPIC_API_KEY="sk-ant-…"
APP_URL="http://localhost:3000"

# --- OpenAIRE MCP (lazy — required on first agent search) -------------------
# The hosted mcp-openaire endpoint (openaire_kg_* / openaire_sx_* tools).
OPENAIRE_MCP_URL="https://…/mcp"
OPENAIRE_MCP_TOKEN="…"

# --- Data-cluster MCP (lazy — required when CLUSTER_MODE=real for RAG) -------
DATACLUSTER_MCP_URL="https://…/mcp"
CLUSTER_BEARER_TOKEN="…"

# --- Ingestion cluster ------------------------------------------------------
# fake = app + Postgres only (no worker); real = dockerized ingest worker.
CLUSTER_MODE="fake"
JOB_CALLBACK_SECRET="change-me-to-a-32-plus-char-random-secret"
# In docker-compose dev the worker cannot resolve the app's localhost; point it
# back at the host. Leave unset in prod (the worker reaches the public APP_URL).
# WORKER_CALLBACK_BASE_URL="http://host.docker.internal:3000"

# --- Agent provider (optional; default anthropic) ---------------------------
AGENT_PROVIDER="anthropic"
# OPENROUTER_API_KEY="sk-or-…"   # required when AGENT_PROVIDER=openrouter

# --- Alien Auth (Authentik OIDC) SSO — optional -----------------------------
# AUTHENTIK_BASE_URL="https://auth.example.com"
# AUTHENTIK_APP_SLUG="datastreaming"
# AUTHENTIK_CLIENT_ID="…"
# AUTHENTIK_CLIENT_SECRET="…"

# --- Langfuse observability — optional --------------------------------------
# LANGFUSE_PUBLIC_KEY="pk-lf-…"
# LANGFUSE_SECRET_KEY="sk-lf-…"
# LANGFUSE_BASE_URL="https://cloud.langfuse.com"
